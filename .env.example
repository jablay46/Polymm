# polymm — example environment file.
#
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# In CI, inject these as repository secrets instead of a file.

# ── Mainnet wallet (LIVE — use a dedicated hot wallet only) ───
# A throwaway trading wallet holding only what you can afford to lose.
# Never the wallet that holds your main funds.
POLYMM_PRIVATE_KEY=
# Funder address. Equal to the signer for a plain EOA; a different
# address means a Polymarket proxy/Safe (signature type 1).
POLYMM_FUNDER_ADDRESS=

# ── L2 API credentials (created once from L1) ─────────────────
POLYMM_API_KEY=
POLYMM_API_SECRET=
POLYMM_API_PASSPHRASE=

# ── Testnet wallet (Polygon Amoy, chain 80002) ────────────────
# MUST be a different key from the mainnet one. Tests skip when unset.
POLYMM_TESTNET_PRIVATE_KEY=

# ── Gates (override config.yaml; safe values shown) ───────────
POLYMM_ENABLE_TRADING=false
POLYMM_MOCK_TRADING=true
